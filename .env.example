# 在 @BotFather 创建 Bot 后获得，格式类似 123456789:AAH...
BOT_TOKEN=

# 允许使用 Bot 的 Telegram 用户 ID，多个用英文逗号分隔
# 不知道自己的 ID：给 @userinfobot 发送任意消息查询
ALLOWED_USER_IDS=

# 以下为可选项，取消注释后生效
# 单个媒体上传上限（MB），范围 1-50，默认 50
# MAX_UPLOAD_MB=50
# 临时文件目录，默认 $STATE_DIR/tmp
# TMP_DIR=/state/tmp
# POLL_TIMEOUT_SECONDS=60
# LOG_LEVEL=info
# 每条消息的分段耗时日志：off / summary / verbose，默认 off
# TIMING_TRACE=summary
# TZ=Asia/Shanghai

# FxTwitter API 基址，一般不需要改
# FXTWITTER_BASE=https://api.fxtwitter.com

# Grok 译文的目标语言，默认 zh-Hans；留空则关闭翻译
# TRANSLATE_LANG=zh-Hans

# 如果服务器访问 Telegram / Twitter 需要代理（例如中国大陆主机）
# 注意：容器内的 127.0.0.1 指向容器自己，代理在宿主机上时请填写可达地址
# HTTPS_PROXY=http://192.168.1.10:7890
# HTTP_PROXY=http://192.168.1.10:7890
